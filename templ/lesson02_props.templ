package templ

// Lesson2: props (arguments) make components reusable.
templ Lesson2(name string, visits int) {
	<section>
		<h1>Lesson 2: Props</h1>
		<p>Hello, <strong>{ name }</strong>!</p>
		<p>You have visited this page <strong>{ visits }</strong> times.</p>
		@Alert("Props are just Go function parameters.")
	</section>
}

templ Alert(message string) {
	<div class="alert">{ message }</div>
}
